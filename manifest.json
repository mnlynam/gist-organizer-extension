{
  "manifest_version": 3,
  "name": "Gist Organizer",
  "version": "2.1.2",
  "description": "Replaces the flat GitHub Gist list with a project-based file explorer and syntax-highlighted editor.",
  "permissions": [],
  "host_permissions": ["https://gist.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://gist.github.com/*"],
      "exclude_matches": [
        "https://gist.github.com/",
        "https://gist.github.com/discover",
        "https://gist.github.com/search*"
      ],
      "css": [
        "hide.css",
        "codemirror/codemirror.min.css",
        "codemirror/theme/material-darker.min.css"
      ],
      "js": [
        "codemirror/codemirror.min.js",
        "codemirror/mode/javascript/javascript.min.js",
        "codemirror/mode/xml/xml.min.js",
        "codemirror/mode/css/css.min.js",
        "codemirror/mode/markdown/markdown.min.js",
        "codemirror/mode/htmlmixed/htmlmixed.min.js",
        "codemirror/addon/edit/matchbrackets.min.js",
        "codemirror/addon/edit/closebrackets.min.js",
        "codemirror/addon/selection/active-line.min.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
